            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\r\n\r\nkeyboard:\r\n  layout: us\r\n\r\nusers:\r\n  - default\r\n  - name: chris\r\n    groups:\r\n      - sudo\r\n    shell: /bin/bash\r\n    sudo: ALL=(ALL) NOPASSWD:ALL\r\n    lock_passwd: false\r\n\r\nchpasswd:\r\n  expire: false\r\n  users:\r\n    - name: root\r\n      password: \"1\"\r\n      type: text\r\n    - name: chris\r\n      password: \"1\"\r\n      type: text\r\n\r\nssh_pwauth: true\r\n\r\npackage_update: true\r\npackage_upgrade: false\r\n\r\npackages:\r\n  - qemu-guest-agent\r\n\r\noutput:\r\n  all: '| tee -a /var/log/cloud-init-output.log'\r\n\r\nruncmd:\r\n  - echo \"==================================================\"\r\n  - echo \"Rozpoczynam konfigurację VM\"\r\n  - echo \"==================================================\"\r\n\r\n  - echo \"[1/2] Uruchamianie QEMU Guest Agent...\"\r\n  - systemctl enable --now qemu-guest-agent\r\n\r\n  - echo \"[2/2] Konfiguracja zakończona.\"\r\n\r\nfinal_message: |\r\n  ==================================================\r\n  CLOUD-INIT COMPLETED\r\n  Version: $version\r\n  Timestamp: $timestamp\r\n  Uptime: $uptime\r\n  Datasource: $datasource\r\n  ==================================================",
                "file_name": "cloud_init_ubuntu_26.yaml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800,
            "upload_mode": "stream"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA==",
          "dependencies": [
            "module.ubuntu26-template.proxmox_download_file.ubuntu26_cloud_image_download"
          ]
        }
      ]
